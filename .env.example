# Example environment variables for YNX-backend
# Copy to .env and edit values for your environment

# Server
PORT=4000
NODE_ENV=development

# Postgres (Prisma)
# Example: postgresql://user:password@localhost:5432/ynxdb?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/ynxdb?schema=public

# Walrus (content-addressed object store)
# Modes: mock | real
WALRUS_MODE=mock
# Walrus SDK configuration (used when WALRUS_MODE=real)
WALRUS_NETWORK=testnet          # testnet | mainnet (defaults to testnet)
WALRUS_EPOCHS=3                 # how many epochs blobs stay available
WALRUS_DELETABLE=true           # allow deleting blobs before expiry
WALRUS_OWNER_ADDRESS=           # optional override; defaults to signer address
WALRUS_PRIVATE_KEY=suiprivkey...# falls back to SUI_PRIVATE_KEY if unset
WALRUS_UPLOAD_RELAY_HOST=       # optional Walrus upload relay URL
WALRUS_UPLOAD_TIP_MAX=          # optional max tip (in MIST) for upload relay
WALRUS_WASM_URL=                # optional custom WASM bundle

# Chain layer mode: stub | evm | sui | walrus
CHAIN_MODE=stub

# Sui blockchain configuration (when CHAIN_MODE=sui)
SUI_NETWORK=testnet
# RPC URL (optional, defaults to public RPC for network)
SUI_RPC_URL=
# Your Sui private key (hex format with 0x prefix or base64)
SUI_PRIVATE_KEY=sui...
# Deployed package ID for your Move contracts
SUI_PACKAGE_ID=0x...
# Module names (if different from defaults)
SUI_ACTION_MODULE=action_log
SUI_GROUP_MODULE=groups

# Allowed external link hosts (comma-separated). If empty => blocks external links.
ALLOWED_LINK_HOSTS=localhost

